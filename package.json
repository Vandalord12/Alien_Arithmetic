{
  "name": "alien arithmetic",
  "version": "1.0.0",
  "description": "Alien Arithmetic",
  "main": "server.js",
  "type": "module",

  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rimraf dist",
    "build:ts": "tsc",
    "copy:static": "copyfiles -u 1 \"src/**/*.html\" \"src/**/*.css\" \"src/**/*.png\" \"src/**/*.jpg\" \"src/**/*.jpeg\" \"src/**/*.svg\" \"src/**/*.webp\" \"src/**/*.ico\" \"src/**/*.json\" dist",
    "build": "npm run clean && npm run build:ts && npm run copy:static",
    "start": "node --env-file=.env dist/server.js",
    "dev": "nodemon --env-file=.env dist/server.js"
  },
  "author": "Muhammed Bachelani",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.11.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
